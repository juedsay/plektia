{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    // Impide que fetch() alcance IPs privadas o internas: primera barrera contra SSRF.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Caché del Worker apagada hasta que `public-page` (F4) defina qué se cachea y
  // con qué etiquetas; el spike de la tarea 6 probó que funciona (ADR 0003).
  "cache": {
    "enabled": false,
  },
  "triggers": {
    // Cada 5 minutos: el cron de `live-status` refresca el estado en vivo.
    "crons": ["*/5 * * * *"],
  },
  // Datos públicos del proyecto de Supabase. En local se reemplazan con
  // `.dev.vars` (`pnpm env:local`); en producción, la publishable key la pasa el
  // deploy desde el entorno de GitHub. Si quedara vacía, nadie tendría sesión.
  "vars": {
    "SUPABASE_URL": "https://xggajfivycgttmgbvgys.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "",
    // Clave pública del widget de Turnstile (contacto). En local, la de prueba.
    "TURNSTILE_SITE_KEY": "",
  },
  // Límite de las acciones de login (SPEC-identity): 10 por minuto por IP y ruta.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    // Formulario de contacto: 3 envíos por minuto por IP (SPEC-public-page, "Contacto").
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
