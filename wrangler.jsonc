{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plektia",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    // Impide que fetch() alcance IPs privadas o internas: primera barrera contra SSRF.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
