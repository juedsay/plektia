{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    // Impide que fetch() alcance IPs privadas o internas: primera barrera contra SSRF.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Caché del Worker (ADR 0003). Qué se cachea y con qué etiquetas lo decide
  // cada respuesta: src/infrastructure/http/cache-policy.ts. Cada deploy
  // arranca con la caché vacía (la versión es parte de la clave).
  "cache": {
    "enabled": true,
  },
  "triggers": {
    // Deben coincidir con src/worker.ts: cada 10 minutos el estado en vivo,
    // cada hora el contenido destacado de YouTube y una vez por mes la
    // retención de las estadísticas (400 días).
    "crons": ["*/10 * * * *", "0 * * * *", "30 3 1 * *"],
  },
  // Datos públicos del proyecto de Supabase. En local se reemplazan con
  // `.dev.vars` (`pnpm env:local`); en producción, la publishable key la pasa el
  // deploy desde el entorno de GitHub. Si quedara vacía, nadie tendría sesión.
  "vars": {
    "SUPABASE_URL": "https://xggajfivycgttmgbvgys.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "",
    // Clave pública del widget de Turnstile (contacto). En local, la de prueba.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFeLgiukytswT6fP",
  },
  // Límite de las acciones de login (SPEC-identity): 10 por minuto por IP y ruta.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    // Formulario de contacto: 3 envíos por minuto por IP (SPEC-public-page, "Contacto").
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 },
    },
    // Actions del panel: 120 por minuto por usuario (SPEC-admin-panel, "Abuso de escritura").
    {
      "name": "ACTIONS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    // Beacon de estadísticas: 30 eventos por minuto por IP (SPEC-click-analytics).
    {
      "name": "STATS_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 },
    },
    // "Comprobar ahora": una vez por minuto por cuenta (SPEC-live-status, historia 3).
    {
      "name": "LIVE_CHECK_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
