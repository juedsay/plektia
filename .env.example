# Variables de entorno de Plektia. Copiá este archivo a `.dev.vars` (local, ignorado por git)
# y completá los valores. En producción se cargan con `wrangler secret put <NOMBRE>`.
# Cada módulo suma las suyas en su tarea; nunca se commitean valores reales.

# Handle que se muestra en la raíz del dominio (`/`).
DEFAULT_HANDLE=juedsay

# Supabase local (`pnpm exec supabase status`): API_URL y PUBLISHABLE_KEY.
# En producción salen de `vars` en wrangler.jsonc.
SUPABASE_URL=http://127.0.0.1:56621
SUPABASE_PUBLISHABLE_KEY=

# YouTube Data API v3 (SPEC-live-status): la crea `scripts/wizard-youtube.sh`.
# En producción es un secreto del Worker. `pnpm env:local` la conserva.
YOUTUBE_API_KEY=
