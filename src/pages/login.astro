---
// Login (SPEC-identity): por ahora solo con invitación. Los botones son links
// GET a /auth/login: la CSP `form-action 'self'` frena los redirects de un POST
// hacia el proveedor.
import { safeRedirectPath } from "@/infrastructure/http/safe-redirect";
import Alert from "@/ui/components/Alert.astro";
import PublicLayout from "@/ui/layouts/PublicLayout.astro";

const next = safeRedirectPath(Astro.url.searchParams.get("next"));
if (Astro.locals.user) return Astro.redirect(next, 303);
const denied = Astro.url.searchParams.has("error");
const loginUrl = (provider: "github" | "google") =>
  `/auth/login?provider=${provider}&next=${encodeURIComponent(next)}`;
---

<PublicLayout
  title="Entrar · Plektia"
  description="Entrá a tu panel de Plektia con GitHub o Google."
  share={false}
>
  <section class="identity" aria-labelledby="login-title">
    <h1 id="login-title">Entrar a Plektia</h1>
    <p class="bio">Por ahora Plektia funciona por invitación.</p>
  </section>

  <div class="login">
    {denied && (
      <Alert
        variant="error"
        message="Esta cuenta no tiene acceso. Pedile una invitación al administrador."
      >
        <div class="alert-actions">
          <a class="button is-quiet" href="/contacto">
            Pedir una invitación
          </a>
        </div>
      </Alert>
    )}

    <nav aria-label="Entrar con">
      <ul class="login-options">
        <li>
          <a class="button login-button" href={loginUrl("github")}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            Entrar con GitHub
          </a>
        </li>
        <li>
          <a class="button login-button" href={loginUrl("google")}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M21.6 12.23c0-.68-.06-1.36-.18-2.02H12v3.83h5.38a4.6 4.6 0 0 1-2 3.02v2.5h3.23c1.9-1.75 2.99-4.33 2.99-7.33ZM12 22c2.7 0 4.97-.9 6.62-2.43l-3.23-2.5c-.9.6-2.05.95-3.39.95-2.6 0-4.81-1.76-5.6-4.12H3.07v2.58A10 10 0 0 0 12 22Zm-5.6-8.1a6 6 0 0 1 0-3.8V7.52H3.07a10 10 0 0 0 0 8.96L6.4 13.9ZM12 5.98c1.47 0 2.79.5 3.83 1.5l2.86-2.87A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.93 5.52L6.4 10.1C7.19 7.74 9.4 5.98 12 5.98Z"
              ></path>
            </svg>
            Entrar con Google
          </a>
        </li>
      </ul>
    </nav>
  </div>
</PublicLayout>
