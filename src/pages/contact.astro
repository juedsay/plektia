---
import { contactSender, turnstileSiteKey } from "@/composition/runtime";
import { CONTACT_LIMITS, HONEYPOT_FIELD } from "@/domain/contact";
import { readForm } from "@/infrastructure/http/form";
import Alert from "@/ui/components/Alert.astro";
import PublicLayout from "@/ui/layouts/PublicLayout.astro";
import { contactFeedback } from "@/ui/view/contact";

import "@/ui/styles/site.css";

// Contacto (SPEC-public-page, "Contacto"): el correo de Plektia nunca aparece
// en la página. Turnstile carga un script de Cloudflare solo acá, por eso la
// CSP se amplía solo en esta página.
const TURNSTILE = "https://challenges.cloudflare.com";
// Al sumar un origen, Astro deja de incluir 'self': hay que repetirlo para el
// script propio de la página.
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource(TURNSTILE);
Astro.csp?.insertDirective(`frame-src ${TURNSTILE}`);

const values = { name: "", email: "", message: "" };
let feedback = contactFeedback(null);

if (Astro.request.method === "POST") {
  const form = await readForm(Astro.request);
  const field = (name: string) => {
    const value = form.get(name);
    return typeof value === "string" ? value : "";
  };
  values.name = field("name");
  values.email = field("email");
  values.message = field("message");

  const result = await contactSender()({
    fields: { ...values, [HONEYPOT_FIELD]: field(HONEYPOT_FIELD) },
    turnstileToken: form.get("cf-turnstile-response"),
    ip: Astro.clientAddress,
  });
  // Post/Redirect/Get: recargar la página no reenvía el mensaje.
  if (result.ok) return Astro.redirect("/contact?enviado", 303);
  feedback = contactFeedback(result.error);
  Astro.response.status = feedback.status;
}

const sent = Astro.request.method === "GET" && Astro.url.searchParams.has("enviado");
const siteKey = turnstileSiteKey();
const canonical = new URL("/contact", Astro.url);
const fields = [
  { name: "name", label: "Tu nombre", type: "text", autocomplete: "name" },
  { name: "email", label: "Tu email", type: "email", autocomplete: "email" },
] as const;
---

<PublicLayout
  title="Contacto · Plektia"
  description="Escribile a Plektia: pedí tu invitación o contanos lo que necesites."
  canonical={canonical}
  width="wide"
>
  <div class="split">
    <section class="identity" aria-labelledby="contact-title">
      <h1 id="contact-title">Contacto</h1>
      <p class="bio">Pedí tu invitación o contanos lo que necesites. Te respondemos por email.</p>
    </section>

    {sent ? (
      <div class="contact-done" data-contact-sent>
        <Alert
          variant="success"
          message="Listo, tu mensaje llegó. Te vamos a responder al email que dejaste."
        >
          <div class="alert-actions">
            <a class="button" href="/">
              Volver al inicio
            </a>
            <a class="button is-quiet" href="/contact">
              Enviar otro mensaje
            </a>
          </div>
        </Alert>
      </div>
    ) : (
      <form class="contact-form" method="post" action="/contact" novalidate data-contact-form>
        <Alert variant="error" message={feedback.summary} id="form-alert" />

        {fields.map((field) => (
          <div class="field">
            <label for={field.name}>{field.label}</label>
            <input
              id={field.name}
              name={field.name}
              type={field.type}
              required
              maxlength={CONTACT_LIMITS[field.name]}
              autocomplete={field.autocomplete}
              value={values[field.name]}
              aria-invalid={feedback.fields[field.name] ? "true" : undefined}
              aria-describedby={`${field.name}-error`}
            />
            <p class="field-error" id={`${field.name}-error`} hidden={!feedback.fields[field.name]}>
              {feedback.fields[field.name]}
            </p>
          </div>
        ))}

        <div class="field">
          <label for="message">Mensaje</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            maxlength={CONTACT_LIMITS.message}
            aria-invalid={feedback.fields["message"] ? "true" : undefined}
            aria-describedby="message-error message-count"
          >{values.message}</textarea>
          <p class="field-hint" id="message-count" data-count>
            Hasta {CONTACT_LIMITS.message} caracteres.
          </p>
          <p class="field-error" id="message-error" hidden={!feedback.fields["message"]}>
            {feedback.fields["message"]}
          </p>
        </div>

        {/* Campo trampa: fuera de la vista y del orden de foco; solo lo completan los bots. */}
        <div class="trap" aria-hidden="true">
          <label for={HONEYPOT_FIELD}>No completes este campo</label>
          <input
            id={HONEYPOT_FIELD}
            name={HONEYPOT_FIELD}
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-language="es" />
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
        <button class="submit button" type="submit" data-submit>
          Enviar mensaje
        </button>
        <p class="form-help">
          Usamos Turnstile de Cloudflare para frenar el spam. Tu IP no se guarda.
        </p>
      </form>
    )}

    <script>
      import "@/ui/scripts/contact-form";
    </script>
  </div>
</PublicLayout>
