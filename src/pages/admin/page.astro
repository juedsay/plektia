---
// Presentación de la página con la que se trabaja (SPEC-admin-panel, "Perfil";
// desde la tarea 17c es de cada página): avatar, nombre, bio, tema y @handle.
import { actions } from "astro:actions";

import {
  ACCENTS,
  AVAILABLE_THEMES,
  BIO_MAX_LENGTH,
  COLOR_MODES,
  LINK_SHAPES,
  UPCOMING_THEMES,
} from "@/domain/page";
import { loadWorkspace } from "@/ui/admin/workspace";
import Alert from "@/ui/components/Alert.astro";
import AdminLayout from "@/ui/layouts/AdminLayout.astro";
import { initialOf } from "@/ui/view/public-link";

const switched = Astro.getActionResult(actions.pages.select);
if (switched?.data?.ok) return Astro.redirect("/admin/page", 303);
const saved = Astro.getActionResult(actions.pages.update);
if (saved?.data?.ok) return Astro.redirect("/admin/page?guardado", 303);
const avatarRemoved = Astro.getActionResult(actions.pages.removeAvatar);
if (avatarRemoved?.data?.ok) return Astro.redirect("/admin/page?sin-avatar", 303);

const { pages, currentPage, account, panelMode } = await loadWorkspace(Astro);
const failure = saved?.data && !saved.data.ok ? saved.data : null;
const fields = failure?.fields ?? {};
// Si falló, se muestra lo que se envió; si no, lo guardado.
const values = {
  displayName: failure?.values["displayName"] ?? currentPage?.displayName ?? "",
  bio: failure ? (failure.values["bio"] ?? "") : (currentPage?.bio ?? ""),
  showHandle: failure ? failure.values["showHandle"] === "on" : (currentPage?.showHandle ?? true),
  colorMode: failure?.values["colorMode"] ?? currentPage?.colorMode ?? "auto",
  accent: failure?.values["accent"] ?? currentPage?.accent ?? "hueso",
  linkShape: failure?.values["linkShape"] ?? currentPage?.linkShape ?? "rows",
};
const message = failure
  ? failure.message
  : saved?.error
    ? "No pudimos guardar los cambios. Probá de nuevo."
    : null;
const justSaved = Astro.url.searchParams.has("guardado") && !saved;
// El avatar se guarda desde el editor (JavaScript) o se saca con un formulario.
const avatarNotice = Astro.url.searchParams.has("avatar")
  ? "Avatar guardado. Tu página pública ya lo muestra."
  : Astro.url.searchParams.has("sin-avatar")
    ? "Avatar sacado: tu página muestra la inicial."
    : null;
const avatarError =
  avatarRemoved?.data && !avatarRemoved.data.ok
    ? avatarRemoved.data.message
    : avatarRemoved?.error
      ? "No pudimos sacar el avatar. Probá de nuevo."
      : null;
const avatarSrc = currentPage?.avatarPath ? `/avatars/${currentPage.avatarPath}` : null;
const publicUrl = currentPage ? new URL(`/${currentPage.handle}`, Astro.url).href : null;
const notice =
  switched?.data && !switched.data.ok
    ? switched.data.message
    : switched?.error
      ? "No pudimos cambiar de página. Probá de nuevo."
      : null;

const MODE_NAMES: Record<string, { name: string; hint: string }> = {
  auto: { name: "Automático", hint: "Clara u oscura según el celular de cada visitante." },
  dark: { name: "Oscuro", hint: "Siempre oscura." },
  light: { name: "Claro", hint: "Siempre clara." },
};

const SHAPE_NAMES: Record<string, { name: string; hint: string }> = {
  rows: { name: "Filas", hint: "Separados por una línea, como hasta ahora." },
  cards: { name: "Tarjetas", hint: "Cada link en su recuadro." },
  pills: { name: "Pastillas", hint: "Cada link en una cápsula redondeada." },
};

const ACCENT_NAMES: Record<string, string> = {
  hueso: "Hueso",
  coral: "Coral",
  ambar: "Ámbar",
  cielo: "Cielo",
  lavanda: "Lavanda",
  rosa: "Rosa",
  turquesa: "Turquesa",
  arena: "Arena",
};

const THEME_NAMES: Record<string, string> = {
  tecnico: "Técnico",
  cercano: "Cercano",
  energico: "Enérgico",
  editorial: "Editorial",
};
---

<AdminLayout
  title="Página"
  section="page"
  pages={pages}
  currentPage={currentPage}
  account={account}
  panelMode={panelMode}
  notice={notice}
>
  <header class="admin-heading">
    <h1>Página</h1>
    <p class="admin-bio">Cómo se presenta tu página: el nombre, la bio y el estilo.</p>
  </header>

  {currentPage ? (
    <>
      <section
        class="avatar-editor"
        aria-labelledby="avatar-title"
        data-avatar-editor
        data-page-id={currentPage.id}
      >
        <h2 id="avatar-title" class="avatar-editor-title">
          Avatar
        </h2>
        {avatarNotice && <Alert variant="success" message={avatarNotice} />}
        {avatarError && <Alert variant="error" message={avatarError} />}
        <div class="avatar-editor-current">
          {avatarSrc ? (
            <img
              class="avatar-editor-image"
              src={avatarSrc}
              alt="Tu avatar actual"
              width="88"
              height="88"
            />
          ) : (
            <div class="avatar-editor-image avatar-editor-initial" aria-hidden="true">
              {initialOf(currentPage.displayName)}
            </div>
          )}
          <div class="avatar-editor-choose">
            <label class="button is-quiet avatar-editor-pick" for="avatar-file">
              Elegir foto
            </label>
            <input
              id="avatar-file"
              class="visually-hidden"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              aria-describedby="avatar-hint"
              data-avatar-file
            />
            <p class="field-hint" id="avatar-hint">
              JPEG, PNG o WebP de hasta 5 MB. Se recorta en cuadrado y se le borran los datos de la
              cámara y la ubicación.
            </p>
            <noscript>
              <p class="field-hint">Para elegir y recortar una foto necesitás JavaScript.</p>
            </noscript>
            {avatarSrc && (
              <form method="post" action={actions.pages.removeAvatar}>
                <input type="hidden" name="pageId" value={currentPage.id} />
                <button type="submit" class="button is-quiet">
                  Sacar avatar
                </button>
              </form>
            )}
          </div>
        </div>

        <p class="field-error" role="alert" data-avatar-error hidden></p>

        <div class="avatar-crop" data-avatar-crop hidden>
          <div class="avatar-crop-frame">
            <canvas
              class="avatar-crop-canvas"
              width="560"
              height="560"
              tabindex="0"
              aria-label="Recorte de la foto"
              aria-describedby="avatar-crop-help"
              data-avatar-canvas
            ></canvas>
          </div>
          <p class="field-hint" id="avatar-crop-help">
            Arrastrá la foto o movela con las flechas. Acercala o alejala con el zoom, o con más y
            menos.
          </p>
          <div class="field">
            <label for="avatar-zoom">Zoom</label>
            <input
              id="avatar-zoom"
              type="range"
              min="1"
              max="4"
              step="0.01"
              value="1"
              data-avatar-zoom
            />
          </div>
          <div class="admin-form-actions">
            <button type="button" class="button" data-avatar-save>
              Guardar avatar
            </button>
            <button type="button" class="button is-quiet" data-avatar-cancel>
              Cancelar
            </button>
          </div>
        </div>
        <p class="visually-hidden" role="status" data-avatar-status></p>
      </section>

      <form class="admin-form" method="post" action={actions.pages.update} novalidate>
        <input type="hidden" name="pageId" value={currentPage.id} />
        {justSaved && publicUrl && (
          <Alert variant="success" message="Guardado. Tu página pública ya muestra los cambios.">
            <div class="alert-actions">
              <a class="button is-quiet" href={publicUrl} target="_blank" rel="noopener">
                Ver página<span class="visually-hidden"> (se abre en otra pestaña)</span>
              </a>
            </div>
          </Alert>
        )}
        {message && <Alert variant="error" message={message} />}

        <div class="field">
          <label for="displayName">Nombre</label>
          <input
            id="displayName"
            name="displayName"
            required
            maxlength="60"
            autocomplete="off"
            value={values.displayName}
            aria-describedby={fields.displayName ? "displayName-error" : undefined}
            aria-invalid={fields.displayName ? "true" : undefined}
          />
          {fields.displayName && (
            <p class="field-error" id="displayName-error">
              {fields.displayName}
            </p>
          )}
        </div>

        <div class="field">
          <label for="bio">Bio</label>
          <textarea
            id="bio"
            name="bio"
            rows="3"
            maxlength={BIO_MAX_LENGTH}
            data-single-line
            data-counter="bio-count"
            aria-describedby={fields.bio ? "bio-error bio-hint" : "bio-hint"}
            aria-invalid={fields.bio ? "true" : undefined}
            set:text={values.bio}
          />
          <p class="field-hint" id="bio-hint">
            Opcional. Una línea, hasta {BIO_MAX_LENGTH} caracteres:{" "}
            <span id="bio-count" class="field-count">
              {values.bio.length} de {BIO_MAX_LENGTH}
            </span>
            .
          </p>
          {fields.bio && (
            <p class="field-error" id="bio-error">
              {fields.bio}
            </p>
          )}
        </div>

        <fieldset class="field choice-group">
          <legend>Tema</legend>
          {/* Con un solo tema disponible, es el elegido. */}
          {AVAILABLE_THEMES.map((theme) => (
            <label class="choice">
              <input type="radio" name="theme" value={theme} checked />
              <span class="choice-name">{THEME_NAMES[theme]}</span>
              <span class="choice-hint">Con el hilo y los jacks, en claro y en oscuro.</span>
            </label>
          ))}
          {UPCOMING_THEMES.map((theme) => (
            <label class="choice is-disabled">
              <input type="radio" name="theme" value={theme} disabled />
              <span class="choice-name">{THEME_NAMES[theme]}</span>
              <span class="choice-hint">Próximamente</span>
            </label>
          ))}
          {fields.theme && <p class="field-error">{fields.theme}</p>}
        </fieldset>

        <fieldset class="field choice-group">
          <legend>Modo</legend>
          {COLOR_MODES.map((mode) => (
            <label class="choice">
              <input
                type="radio"
                name="colorMode"
                value={mode}
                checked={values.colorMode === mode}
              />
              <span class="choice-name">{MODE_NAMES[mode]?.name}</span>
              <span class="choice-hint">{MODE_NAMES[mode]?.hint}</span>
            </label>
          ))}
          {fields.colorMode && <p class="field-error">{fields.colorMode}</p>}
        </fieldset>

        <fieldset class="field choice-group" aria-describedby="accent-hint">
          <legend>Acento</legend>
          <p class="field-hint" id="accent-hint">
            El color del hilo, los jacks y los títulos de sección. Cada uno tiene su tono para claro
            y para oscuro.
          </p>
          <div class="accent-options">
            {ACCENTS.map((accent) => (
              <label class="accent-option">
                <input
                  type="radio"
                  name="accent"
                  value={accent}
                  checked={values.accent === accent}
                />
                <span class="accent-swatch" data-accent={accent} aria-hidden="true" />
                <span class="choice-name">{ACCENT_NAMES[accent]}</span>
              </label>
            ))}
          </div>
          {fields.accent && <p class="field-error">{fields.accent}</p>}
        </fieldset>

        <fieldset class="field choice-group">
          <legend>Forma de los links</legend>
          {LINK_SHAPES.map((shape) => (
            <label class="choice">
              <input
                type="radio"
                name="linkShape"
                value={shape}
                checked={values.linkShape === shape}
              />
              <span class="choice-name">{SHAPE_NAMES[shape]?.name}</span>
              <span class="choice-hint">{SHAPE_NAMES[shape]?.hint}</span>
            </label>
          ))}
          {fields.linkShape && <p class="field-error">{fields.linkShape}</p>}
        </fieldset>

        <div class="field">
          <label class="choice">
            <input type="checkbox" name="showHandle" checked={values.showHandle} />
            <span class="choice-name">Mostrar @{currentPage.handle}</span>
            <span class="choice-hint">Debajo de tu nombre, en la página pública.</span>
          </label>
        </div>

        <div class="admin-form-actions">
          <button type="submit" class="button">
            Guardar cambios
          </button>
        </div>
      </form>
    </>
  ) : (
    <div class="admin-empty">
      <p class="admin-empty-title">No encontramos tu página.</p>
      <p>Recargá en unos segundos.</p>
    </div>
  )}
</AdminLayout>
