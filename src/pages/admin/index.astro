---
// Inicio del panel: el resumen de la página con la que se trabaja. En la tarea
// 19 lo reemplaza el editor de links.
import { actions } from "astro:actions";

import { loadWorkspace } from "@/ui/admin/workspace";
import AdminLayout from "@/ui/layouts/AdminLayout.astro";
import { describeCount, summarizePage } from "@/ui/view/page-summary";

const switched = Astro.getActionResult(actions.pages.select);
if (switched?.data?.ok) return Astro.redirect(Astro.url.pathname, 303);

const { repositories, pages, currentPage } = await loadWorkspace(Astro);
const summary = currentPage
  ? summarizePage(await repositories.linksOf(currentPage.id).listOwn())
  : null;
const publicUrl = currentPage ? new URL(`/${currentPage.handle}`, Astro.url) : null;
const notice =
  switched?.data && !switched.data.ok
    ? switched.data.message
    : switched?.error
      ? "No pudimos cambiar de página. Probá de nuevo."
      : null;
---

<AdminLayout title="Inicio" section="home" pages={pages} currentPage={currentPage} notice={notice}>
  {currentPage && publicUrl && summary ? (
    <>
      <header class="admin-heading">
        <h1>{currentPage.displayName}</h1>
        <a class="admin-public-link" href={publicUrl.href} target="_blank" rel="noopener">
          {publicUrl.host}
          <span class="admin-public-path">{publicUrl.pathname}</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
          <span class="visually-hidden">(se abre en otra pestaña)</span>
        </a>
        {currentPage.bio && <p class="admin-bio">{currentPage.bio}</p>}
      </header>

      <section class="admin-block" aria-labelledby="contenido-pagina">
        <h2 id="contenido-pagina">
          Contenido <span class="admin-count">{describeCount(summary.linkCount, 0)}</span>
        </h2>
        {summary.groups.length > 0 ? (
          <ul class="admin-groups">
            {summary.groups.map((group) => (
              <li class="admin-group">
                <span
                  class:list={["admin-jack", { "is-hidden": !group.visible }]}
                  aria-hidden="true"
                />
                <span class="admin-group-title">
                  {group.title}
                  {!group.visible && <span class="admin-tag">Oculta</span>}
                </span>
                <span class="admin-group-count">
                  {describeCount(group.linkCount, group.hiddenCount)}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="admin-empty">
            <p class="admin-empty-title">Esta página todavía no tiene links.</p>
            <p>El editor de links es lo próximo que se suma al panel.</p>
          </div>
        )}
      </section>
    </>
  ) : (
    <div class="admin-empty">
      <p class="admin-empty-title">No encontramos tu página.</p>
      <p>
        Recargá en unos segundos. Si sigue así, escribinos desde <a href="/contact">contacto</a>.
      </p>
    </div>
  )}
</AdminLayout>
