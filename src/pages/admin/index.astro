---
// Inicio del panel: el editor de links de la página con la que se trabaja
// (SPEC-admin-panel, "Editor"). Es la única isla de React del panel.
import { actions } from "astro:actions";

import { loadWorkspace } from "@/ui/admin/workspace";
import AdminLayout from "@/ui/layouts/AdminLayout.astro";
import EditorIsland from "@/ui/islands/Editor";
import { DRAG_STYLE_HASHES } from "@/ui/islands/editor/drag-styles";

// Los estilos que dnd-kit inyecta al arrastrar, habilitados por hash (ver drag-styles.ts).
for (const hash of DRAG_STYLE_HASHES) Astro.csp?.insertStyleHash(hash);

const switched = Astro.getActionResult(actions.pages.select);
if (switched?.data?.ok) return Astro.redirect(Astro.url.pathname, 303);

const { repositories, pages, currentPage } = await loadWorkspace(Astro);
const content = currentPage ? await repositories.linksOf(currentPage.id).listOwn() : null;
const publicUrl = currentPage ? new URL(`/${currentPage.handle}`, Astro.url) : null;
const notice =
  switched?.data && !switched.data.ok
    ? switched.data.message
    : switched?.error
      ? "No pudimos cambiar de página. Probá de nuevo."
      : null;
---

<AdminLayout
  title="Inicio"
  section="home"
  pages={pages}
  currentPage={currentPage}
  notice={notice}
  wide
>
  {currentPage && publicUrl && content ? (
    <>
      <header class="admin-heading">
        <h1>{currentPage.displayName}</h1>
        <a class="admin-public-link" href={publicUrl.href} target="_blank" rel="noopener">
          {publicUrl.host}
          <span class="admin-public-path">{publicUrl.pathname}</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
          <span class="visually-hidden">(se abre en otra pestaña)</span>
        </a>
        {currentPage.bio && <p class="admin-bio">{currentPage.bio}</p>}
      </header>

      <div class="workspace" data-workspace>
        <div class="workspace-tabs" role="tablist" aria-label="Editor y vista previa" hidden>
          <button
            type="button"
            role="tab"
            id="tab-editar"
            aria-controls="panel-editar"
            aria-selected="true"
          >
            Editar
          </button>
          <button
            type="button"
            role="tab"
            id="tab-vista-previa"
            aria-controls="panel-vista-previa"
            aria-selected="false"
            tabindex="-1"
          >
            Vista previa
          </button>
        </div>

        <div
          class="workspace-editor"
          id="panel-editar"
          role="tabpanel"
          aria-labelledby="tab-editar"
        >
          <EditorIsland client:load pageId={currentPage.id} initialContent={content} />
        </div>

        <section
          class="workspace-preview"
          id="panel-vista-previa"
          role="tabpanel"
          aria-labelledby="tab-vista-previa"
        >
          <h2 class="workspace-preview-title">Vista previa</h2>
          <p class="workspace-preview-hint">Así la ve quien la visita. Se actualiza al guardar.</p>
          <iframe
            class="workspace-preview-frame"
            src="/admin/vista-previa"
            title={`Vista previa de ${currentPage.displayName}`}
            data-preview-frame
          ></iframe>
        </section>
      </div>
    </>
  ) : (
    <div class="admin-empty">
      <p class="admin-empty-title">No encontramos tu página.</p>
      <p>
        Recargá en unos segundos. Si sigue así, escribinos desde <a href="/contact">contacto</a>.
      </p>
    </div>
  )}
</AdminLayout>
