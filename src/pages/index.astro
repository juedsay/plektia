---
import { landingLinks } from "@/content/landing";
import Bank from "@/ui/components/Bank.astro";
import Isotype from "@/ui/components/Isotype.astro";
import PublicLayout from "@/ui/layouts/PublicLayout.astro";

// Landing de Plektia (como `linktr.ee/`): una sola pantalla, honesta. La versión
// completa (beneficios, ejemplos, preguntas) llega con el registro abierto (v2).
const canonical = new URL("/", Astro.url);
const description =
  "Plektia: todos tus links en una sola página, unidos por un hilo. Por ahora, por invitación.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Plektia",
  url: canonical.href,
  description,
};
---

<PublicLayout
  title="Plektia · Todos tus links, unidos por un hilo"
  description={description}
  canonical={canonical}
  structuredData={structuredData}
>
  <section class="identity hero" aria-labelledby="hero-title">
    <div class="avatar" aria-hidden="true">
      <Isotype size={44} />
    </div>
    <h1 id="hero-title">plektia</h1>
    <p class="handle">Todo tejido.</p>
    <p class="bio">
      Todos tus links en una sola página, unidos por un hilo: tus redes, tus proyectos y tus
      streams.
    </p>
  </section>
  <div class="patchbay" data-patchbay>
    <svg class="thread" aria-hidden="true"></svg>
    <Bank id="empezar" title="Empezá acá" links={landingLinks()} />
  </div>
  <p class="invite">Por ahora Plektia funciona por invitación.</p>
</PublicLayout>
