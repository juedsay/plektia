---
import { getPublicPage } from "@/application/public/get-public-page";
import { defaultHandle, publicPages } from "@/composition/runtime";
import ProfilePage from "@/ui/components/ProfilePage.astro";

// La raíz muestra el perfil de `DEFAULT_HANDLE` (SPEC-public-page, "Raíz del
// dominio"); en la v2 la reemplaza la landing de Plektia.
const result = await getPublicPage({ pages: publicPages() })(defaultHandle());
if (!result.ok) return Astro.rewrite("/404");
---

<ProfilePage page={result.value} />
