---
// Isotipo de Plektia: tres jacks en columna unidos por el cable y el jack lima.
interface Props {
  size?: number;
}
const { size } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <path
    d="M18 54V12H34A12 12 0 0 1 34 36H18"
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linejoin="round"
  ></path>
  <circle cx="18" cy="12" r="5" fill="currentColor"></circle>
  <circle cx="18" cy="36" r="5" fill="currentColor"></circle>
  <circle cx="18" cy="54" r="5" fill="currentColor"></circle>
  <circle cx="46" cy="24" r="5.5" fill="var(--color-live)"></circle>
</svg>
