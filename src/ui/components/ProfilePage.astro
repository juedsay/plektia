---
import type { PublicPage } from "@/application/ports/public-page-reader";
import Bank from "@/ui/components/Bank.astro";
import ProfileHeader from "@/ui/components/ProfileHeader.astro";
import PublicLayout from "@/ui/layouts/PublicLayout.astro";
import { profileJsonLd } from "@/ui/view/seo";

interface Props {
  page: PublicPage;
  brand?: boolean;
  /** Vista previa del panel: sin URL canónica (no se indexa) y con los links afuera del marco. */
  preview?: boolean;
}
const { page, brand = false, preview = false } = Astro.props;
// La raíz (`/`) también muestra un perfil, pero su URL canónica es siempre `/{handle}`.
const canonical = new URL(`/${page.handle}`, Astro.url);
const description = page.bio ?? `Todos los links de ${page.displayName} en un solo lugar.`;
---

<PublicLayout
  title={brand ? "Plektia · Página oficial" : `${page.displayName} · Plektia`}
  description={description}
  canonical={preview ? undefined : canonical}
  theme={page.theme}
  mode={page.colorMode}
  accent={page.accent}
  type="profile"
  structuredData={preview ? undefined : profileJsonLd(page, canonical)}
  preview={preview}
  publicUrl={canonical}
  sharePreview={{ name: page.displayName, brand }}
>
  <ProfileHeader page={page} brand={brand} />
  {/* El beacon de estadísticas cuenta visitas y clics de esta página; en la vista previa, nada. */}
  <div class="patchbay" data-patchbay data-stats-handle={preview ? undefined : page.handle}>
    <svg class="thread" aria-hidden="true"></svg>
    {page.sections.map((section) => (
      <Bank
        id={section.id}
        title={section.title}
        showTitle={section.showTitle}
        links={section.links}
      />
    ))}
    <Bank id="sin-seccion" links={page.unsectionedLinks} />
  </div>
</PublicLayout>
