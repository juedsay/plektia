---
import { jsonLd } from "@/ui/view/seo";

interface Props {
  title: string;
  description: string;
  /** URL canónica absoluta; sin ella la página no se indexa (404). */
  canonical?: URL | undefined;
  type?: "website" | "profile" | undefined;
  structuredData?: Record<string, unknown> | undefined;
}
const { title, description, canonical, type = "website", structuredData } = Astro.props;
const image = new URL("/og.png", Astro.url);
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:site_name" content="Plektia" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Plektia: todo tejido." />
<meta property="og:locale" content="es_AR" />
<meta name="twitter:card" content="summary_large_image" />

{structuredData && (
  <script type="application/ld+json" is:inline set:html={jsonLd(structuredData)} />
)}
