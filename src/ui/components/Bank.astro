---
import type { PublicLink } from "@/application/ports/public-page-reader";
import Port from "@/ui/components/Port.astro";

interface Props {
  /** Sin título (los links "Sin sección") el banco no tiene rótulo. */
  title?: string;
  showTitle?: boolean;
  id: string;
  links: readonly PublicLink[];
}
const { title, showTitle = true, id, links } = Astro.props;
const headingId = `bank-${id}`;
---

{links.length > 0 &&
  (title && showTitle ? (
    <section class="bank" aria-labelledby={headingId}>
      <h2 id={headingId}>{title}</h2>
      <ul class="ports">
        {links.map((link) => (
          <Port link={link} />
        ))}
      </ul>
    </section>
  ) : (
    <section class="bank" aria-label={title ?? "Más links"}>
      <ul class="ports">
        {links.map((link) => (
          <Port link={link} />
        ))}
      </ul>
    </section>
  ))}
