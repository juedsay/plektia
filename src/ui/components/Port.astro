---
import PreviewThumb from "@/ui/components/PreviewThumb.astro";
import type { PublicLink } from "@/application/ports/public-page-reader";
import NetworkIcon from "@/ui/components/NetworkIcon.astro";
import {
  featuredLabel,
  formatDuration,
  thumbPath,
  timeAgo,
  watchLabel,
  watchUrl,
} from "@/ui/view/featured";
import { liveElapsed } from "@/ui/view/live";
import { isProfileLink, linkMeta } from "@/ui/view/public-link";
import { socialProfileFor } from "@/ui/view/social-profile";

interface Props {
  link: PublicLink;
}
const { link } = Astro.props;
const network = socialProfileFor(link.url)?.network ?? null;
const featured = link.featured ?? null;
const panelId = `featured-${link.id}`;
const live = link.live ?? null;
// Misma pestaña a propósito: en los navegadores de las apps sociales una
// pestaña nueva confunde (SPEC-public-page). La URL ya viene validada.
---

<li class:list={["port", { "is-live": live, "is-highlighted": link.highlight === "accent" }]}>
  <span class="jack" aria-hidden="true"></span>
  <div class="port-body">
    <a
      class="port-link"
      href={link.url}
      rel={isProfileLink(link) ? "me" : undefined}
      data-link-id={link.id}
    >
      <span>
        <span class="port-name">
          <NetworkIcon network={network} />
          {link.title}
        </span>
        {live ? (
          <span class="port-meta">
            <span class="live-label">En vivo</span>
            {live.startedAt && (
              <>
                {" · "}
                {/* El reloj avanza cada segundo (page.ts) desde `data-live-since`. */}
                <span class="live-time" data-live-since={live.startedAt}>
                  {liveElapsed(live.startedAt, Date.now())}
                </span>
              </>
            )}
            {live.title && ` · ${live.title}`}
          </span>
        ) : (
          <span class="port-meta">{linkMeta(link)}</span>
        )}
      </span>
      <PreviewThumb link={link} />
      <svg
        class="go"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M8 7h9v9"></path>
      </svg>
    </a>
    {featured && (
      <>
        <button
          class="latest-toggle"
          type="button"
          data-disclosure
          aria-expanded="false"
          aria-controls={panelId}
        >
          {/* El título primero y la fecha al final; qué es ("Último video") lo dice el
              nombre accesible, sin un rótulo encima del título. */}
          <span class="latest-text">
            <span class="visually-hidden">{featuredLabel(featured)}: </span>
            <span class="latest-title">{featured.title}</span>
            <span class="port-meta latest-when">
              {" · "}
              {timeAgo(featured.publishedAt, new Date())}
            </span>
          </span>
          <svg
            class="chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div class="latest-panel" id={panelId} inert>
          <div>
            <a
              class:list={["latest-video", { "is-short": featured.kind === "short" }]}
              href={watchUrl(featured)}
              aria-label={watchLabel(featured)}
            >
              {/* Sin `src` hasta que se abre (page.ts): cerrado no pide nada. */}
              <img
                data-src={thumbPath(featured.videoId)}
                alt=""
                width={featured.kind === "short" ? 270 : 480}
                height={featured.kind === "short" ? 480 : 270}
                decoding="async"
              />
              {featured.durationSeconds ? (
                <span class="duration" aria-hidden="true">
                  {formatDuration(featured.durationSeconds)}
                </span>
              ) : null}
            </a>
          </div>
        </div>
      </>
    )}
  </div>
</li>
