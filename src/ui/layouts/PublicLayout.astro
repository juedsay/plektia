---
import { Font } from "astro:assets";

import "@/ui/styles/tokens.css";
import "@/ui/styles/base.css";
import "@/ui/styles/page.css";

import Footer from "@/ui/components/Footer.astro";
import Seo from "@/ui/components/Seo.astro";
import ShareDialog from "@/ui/components/ShareDialog.astro";
import Topbar from "@/ui/components/Topbar.astro";
import type { ColorMode } from "@/domain/page";

interface Props {
  title: string;
  description: string;
  /** URL canónica absoluta; se omite en páginas que no deben indexarse (404). */
  canonical?: URL | undefined;
  theme?: "tecnico";
  /** Claro, oscuro o el del dispositivo de quien visita (SPEC-appearance). */
  mode?: ColorMode;
  type?: "website" | "profile";
  structuredData?: Record<string, unknown> | undefined;
  share?: boolean;
  /** Tarjeta de la ventana de compartir; sin ella, se muestra la marca Plektia. */
  sharePreview?: { name: string; brand?: boolean };
  /**
   * `column`: una columna de celular en cualquier pantalla (páginas de links).
   * `wide`: las páginas del sitio, que en escritorio usan el ancho (site.css).
   */
  width?: "column" | "wide";
  /** Dentro de la vista previa del panel: los links se abren en otra pestaña, no en el marco. */
  preview?: boolean;
  /** Lo que se comparte cuando no hay canónica (la vista previa comparte el perfil público). */
  publicUrl?: URL | undefined;
}
const {
  title,
  description,
  canonical,
  theme = "tecnico",
  mode = "auto",
  type,
  structuredData,
  share = true,
  sharePreview,
  width = "column",
  preview = false,
  publicUrl,
} = Astro.props;
// Se comparte la URL canónica (sin query strings); si no hay, la pública indicada
// o, en último caso, la de la página.
const shareUrl = (canonical ?? publicUrl ?? new URL(Astro.url.pathname, Astro.url)).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* La barra del navegador acompaña al modo (los fondos de tokens.css). */}
    {mode === "auto" ? (
      <>
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f4ef" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121315" />
      </>
    ) : (
      <meta name="theme-color" content={mode === "light" ? "#f5f4ef" : "#121315"} />
    )}
    {preview && <base target="_blank" />}
    <Font cssVariable="--font-brand" preload />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      structuredData={structuredData}
    />
    <slot name="head" />
  </head>
  <body data-theme={theme} data-mode={mode}>
    <div class:list={["page", { "is-wide": width === "wide" }]}>
      <Topbar share={share} siteNav={width === "wide"} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <p class="toast" role="status" aria-live="polite" data-toast></p>
    {share && (
      <ShareDialog
        url={shareUrl}
        title={title}
        name={sharePreview?.name ?? "Plektia"}
        brand={sharePreview?.brand ?? !sharePreview}
      />
    )}
    <script>
      import "@/ui/scripts/page";
    </script>
  </body>
</html>
