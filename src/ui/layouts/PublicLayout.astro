---
import { Font } from "astro:assets";

import "@/ui/styles/tokens.css";
import "@/ui/styles/page.css";

import Footer from "@/ui/components/Footer.astro";
import Seo from "@/ui/components/Seo.astro";
import Topbar from "@/ui/components/Topbar.astro";

interface Props {
  title: string;
  description: string;
  /** URL canónica absoluta; se omite en páginas que no deben indexarse (404). */
  canonical?: URL;
  theme?: "tecnico";
  type?: "website" | "profile";
  structuredData?: Record<string, unknown>;
}
const { title, description, canonical, theme = "tecnico", type, structuredData } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121315" />
    <Font cssVariable="--font-brand" preload />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      structuredData={structuredData}
    />
  </head>
  <body data-theme={theme}>
    <div class="page">
      <Topbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <p class="toast" role="status" aria-live="polite" data-toast></p>
    <script>
      import "@/ui/scripts/page";
    </script>
  </body>
</html>
