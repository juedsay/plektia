{
  "name": "plektia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Página de links con detección de streams en vivo, panel y servidor MCP.",
  "author": "Julian Simon",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "check": "wrangler types && astro check && tsc --noEmit",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/infrastructure/supabase/database.types.ts && prettier --write src/infrastructure/supabase/database.types.ts",
    "test:db": "supabase test db",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "user:allow": "node scripts/allow-user.ts",
    "env:local": "node scripts/dev-vars.ts",
    "db:advisors": "supabase db advisors --local --fail-on warn",
    "test:e2e": "playwright test",
    "audit:deps": "pnpm audit --audit-level=high",
    "deploy:worker": "wrangler deploy"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
