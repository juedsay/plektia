{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "**/*",
    "src/pages/.well-known/**/*"
  ],
  "exclude": ["dist", "prototypes", ".semgrep"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
